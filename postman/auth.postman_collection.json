{
  "info": {
    "name": "Flask Users API - Examples",
    "_postman_id": "flask-users-examples",
    "description": "Colección con ejemplos organizados por carpetas: Users y Auth (HttpOnly cookies)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/users?page=1&pageSize=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["users"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "pageSize", "value": "10"}
              ]
            }
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/users/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["users", ":id"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"username\": \"demouser\",\n  \"email\": \"user@example.com\",\n  \"phone\": \"1234567890\",\n  \"website\": \"example.com\",\n  \"password\": \"secret\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["users"]
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Name\",\n  \"username\": \"updated\",\n  \"email\": \"user@example.com\",\n  \"phone\": \"0987654321\",\n  \"website\": \"example.org\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/users/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["users", ":id"]
            }
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/users/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["users", ":id"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "http://localhost:5000/api/auth/refresh",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "refresh"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Enable 'Send cookies' in Postman or use Interceptor so the refreshToken cookie is sent with this request"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "http://localhost:5000/api/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "logout"]
            }
          }
        }
        ,
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/auth/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "me"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Ensure cookies are sent with this request (use 'Send cookies' or Interceptor in Postman)"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
